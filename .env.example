# Copy to .env for local development. Never commit .env.

# Meta Model API key for Muse Ember. Only needed for real (non-replay) calls.
MODEL_API_KEY=

# 1 replays recorded Ember responses and makes no API calls, which costs $0.
# Development, tests, and CI use 1. Set 0 only for a deliberate real run.
REPLAY=1

# Where runtime data goes: SQLite files, recordings, anything downloaded.
# Defaults to the repository's data/ directory.
# BEACON_DATA_DIR=

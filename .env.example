# The environment variables Beacon uses. Nothing loads this file or a .env file:
# export a variable in your shell, or put it in front of the command. Never commit
# a key.
#
# The scaffold reads none of these yet. The names are reserved for the Ember
# client (Phase 1, part 2), which gives them effect.

# Meta Model API key for Muse Ember. Only needed for real (non-replay) calls.
MODEL_API_KEY=

# 1 answers from recorded Ember responses and makes no API calls, which costs $0.
# Tests and CI set 1. 0 is only for a deliberate real run.
REPLAY=1

# Where runtime data goes: SQLite files, recordings, anything downloaded.
# The repository's data/ directory when unset.
# BEACON_DATA_DIR=

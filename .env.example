# The environment variables Beacon uses. The server does not load this file or the
# repository-root .env file: export a variable in your shell, or put it in front of
# the command. Never commit a key.
#
# The Ember client reads these (EmberClient.from_env in server/beacon/ember/). The
# two EMBER_ settings are read from the process's environment only.

# Meta Model API key for Muse Ember. Read only when REPLAY=0, which also needs
# EMBER_SPENT_BEFORE_USD below.
MODEL_API_KEY=

# 1 answers from recorded Ember responses and makes no API calls, which costs $0.
# It is the default, and tests and CI set it. 0 is only for a deliberate real run.
REPLAY=1

# The most the Ember ledger may hold in live spend, in dollars. A paid call that
# could pass it is refused. 3.00 when unset: the plan's "$3 above the Usage page
# total of Nov 26, 2026", the day the ledger began.
# EMBER_STOP_USD=3.00

# The total spend against the $10 credit that Meta's Usage page
# (https://dev.meta.ai/usage) showed before Beacon's first call, in dollars: every
# model, with no model filter. It has no default: with REPLAY=0 the client is
# refused until this is set, to 0 if that is what the page showed. The stop and
# this together may not pass $9.00 of the $10.00 credit.
# EMBER_SPENT_BEFORE_USD=

# Where runtime data goes: the Ember ledger, trace, and recordings, and later
# SQLite files and downloads. The repository's data/ directory when unset. It must
# be an absolute path, and every process that makes paid calls must use the same
# one: the spending stop is counted in the one ledger file under it.
# BEACON_DATA_DIR=
